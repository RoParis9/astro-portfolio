---
import { info } from "@data";

import Layout from "@layouts/Layout.astro";
import Hero from "@components/home/Hero.astro";
import Experience from "@components/home/Experience.astro";
import ProjectsWrapper from "@components/general/ProjectsWrapper.astro";
import MetaHead from "@components/general/MetaHead.astro";

const featureProjects = info.projects.reduce((accumulator, project) => {
  if (accumulator.length < 6 && project.isFeatured) {
    accumulator.push(project);
  }
  return accumulator;
}, []);

// Default to English for initial render
const defaultLang = "en";
const name = typeof info.name === 'string' ? info.name : info.name[defaultLang];
const about = typeof info.about === 'string' ? info.about : info.about[defaultLang];
const experience = Array.isArray(info.experience) ? info.experience : info.experience[defaultLang];
const education = Array.isArray(info.education) ? info.education : info.education[defaultLang];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <MetaHead
      title={"Portfolio"}
      description={about}
      ogImageUrl={"/assets/images/profile.png"}
    />
  </head>

  <body>
    <Layout>
      <Hero name={info.name} about={info.about} />
      <Experience title={"EXPERIENCE"} details={experience} />
      <Experience title={"EDUCATION"} details={education} />
      <section>
        <h2 data-i18n="projects.title" class="w-[15rem] dark:text-light mt-16">PROJECTS</h2>
        <ProjectsWrapper projects={featureProjects} />
      </section>
    </Layout>
  </body>
</html>
