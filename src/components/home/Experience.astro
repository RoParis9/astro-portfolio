---
import { IExperiences } from "@types";

const { title, details } = Astro.props as IExperiences;
// Handle both string and object types for title
const displayTitle = typeof title === 'string' ? title : title.en || title;
// Determine if this is experience or education section
const sectionType = displayTitle.toUpperCase().includes("EDUCATION") || displayTitle.toUpperCase().includes("EDUCAÇÃO") ? "education" : "experience";
---

<section
  class="flex items-start justify-between flex-col sm:flex-row dark:text-light"
>
  <h2 data-i18n={`${sectionType}.title`} class="w-[15rem] mt-16">{displayTitle}</h2>
  <div class="w-full">
    {
      details.map((item, index) => (
        <div data-i18n-section={sectionType} data-section-index={index} class="my-16">
          <div class="flex justify-between items-center flex-wrap">
            <h3 data-i18n={sectionType === "education" ? "edu.name" : "exp.name"} class="text-xl font-semibold">{item.name}</h3>
            <p data-i18n={sectionType === "education" ? "edu.date" : "exp.date"} class="text-sm dark:text-gray">
              {item.startDate} - {item.endDate}
            </p>
          </div>
          <p data-i18n={sectionType === "education" ? "edu.location" : "exp.location"} class="text-sm mt-3 text-blue">{item.location}</p>
          <ul data-i18n={sectionType === "education" ? "edu.description" : "exp.description"} class="mt-3 space-y-2">
            {item.description.map((desc) => (
              <li class="dark:text-gray">{desc}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
